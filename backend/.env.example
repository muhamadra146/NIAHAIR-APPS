# Contoh isi backend/.env — salin jadi .env lalu isi nilainya. Jangan commit .env asli.

NODE_ENV=production
PORT=3000
TZ=Asia/Jakarta

# Di server: HOST=127.0.0.1 (hanya lewat Nginx) dan TRUST_PROXY=1 (IP asli staff untuk rate limit login)
# Di laptop (tanpa Nginx): kosongkan keduanya
HOST=127.0.0.1
TRUST_PROXY=1

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/salon_erp

# openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=

# Alamat frontend (CORS & link email reset password)
APP_URL=https://erp.niahair.id

# Worker sync Accurate
ENABLE_WORKER=true

ACCURATE_BASE_URL=
ACCURATE_ACCESS_TOKEN=
ACCURATE_APP_KEY=
ACCURATE_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
