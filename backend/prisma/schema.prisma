model TreatmentJobAssignment {
  id String @id @default(uuid())

  treatmentItemId String

  // Sistem lama (ServiceJobSlot based) — nullable setelah migrasi ke sistem baru
  serviceJobSlotId String?

  // Sistem baru (CommissionJob based) — job dari kategori komisi item
  commissionJobId String?

  employeeId String? // null = tidak ada yang mengerjakan → tidak ada komisi

  workQty Decimal? @db.Decimal(10, 2)
  // Hanya relevan untuk slot.commissionMode = WORK_QTY (jumlah helaian)
  // Null untuk FIXED_RATE

  commissionAmount Decimal? @db.Decimal(18, 2)
  // Nominal komisi yang diinput manual saat selesaikan treatment.
  // Jika terisi → commission engine pakai nilai ini langsung (tidak kalkulasi ulang dari %).
  // Jika null  → commission engine hitung dari rate × subtotal (backward compat).

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatmentItem  TreatmentItem   @relation(fields: [treatmentItemId], references: [id])
  serviceJobSlot ServiceJobSlot? @relation(fields: [serviceJobSlotId], references: [id])
  commissionJob  CommissionJob?  @relation(fields: [commissionJobId], references: [id])
  employee       Employee?       @relation(fields: [employeeId], references: [id])

  commission Commission?

  @@index([treatmentItemId])
  @@index([serviceJobSlotId])
  @@index([commissionJobId])
  @@index([employeeId])
  @@map("treatment_job_assignments")
}

