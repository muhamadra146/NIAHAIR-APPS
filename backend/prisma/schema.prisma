model CustomerNote {
  id String @id @default(uuid())

  customerId String

  note String

  createdBy String?

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_notes")
}

model AuditLog {
  id String @id @default(uuid())

  userId String?

  module String

  action String

  recordId String?

  oldData Json?

  newData Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([module])
  @@index([recordId])
  @@map("audit_logs")
}

enum SyncDirection {
  ACCURATE_TO_APP
  APP_TO_ACCURATE
}

enum SyncStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum SyncEntityType {
  CUSTOMER
  WAREHOUSE
  ITEM
  UNIT
  ITEM_UNIT
  ITEM_PRICE
  INVENTORY
  DEPOSIT
  INVOICE
  PAYMENT
  DEPOSIT_PAYMENT
  STOCK_TRANSFER
  STOCK_TRANSFER_RECEIVE
  PURCHASE_INVOICE
}

enum SyncQueueStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Setting {
  id String @id @default(uuid())

  key String @unique

  value String

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SyncQueue {
  id String @id @default(uuid())

  entityType SyncEntityType

  entityId String?

  direction SyncDirection

  status SyncQueueStatus @default(PENDING)

  payload Json?

  attempt    Int @default(0)
  maxAttempt Int @default(3)

  errorMessage String?

  startedAt   DateTime?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("sync_queues")
}

model SyncLog {
  id String @id @default(uuid())

  queueId String?

  entityType String

  entityId String?

  requestPayload Json?

  responsePayload Json?

  status SyncStatus

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([entityType])
  @@map("sync_logs")
}

model BackgroundJob {
  id String @id @default(uuid())

  jobName String

  status JobStatus

  payload Json?

  startedAt DateTime?

  finishedAt DateTime?

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([jobName])
  @@index([status])
  @@map("background_jobs")
}

model WebhookLog {
  id String @id @default(uuid())

  source String

  event String

  payload Json?

  processed Boolean @default(false)

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([source])
  @@index([event])
  @@map("webhook_logs")
}

model AccurateCredential {
  id String @id @default(uuid())

  sessionId String?

  databaseId String?

  accessToken String?

  refreshToken String?

  expiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accurate_credentials")
}

model AccurateMapping {
  id String @id @default(uuid())

  entityType String

  localId String

  accurateId Int

  lastSyncAt DateTime?

  createdAt DateTime @default(now())

  @@unique([entityType, localId])
  @@index([accurateId])
  @@map("accurate_mappings")
}

// =====================================================
// SHIFTS & STAFF SCHEDULES (ROSTER)
// =====================================================

enum ScheduleStatus {
  WORKING
  OFF
  LEAVE
  IZIN
  SAKIT
}

enum SickLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PermissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PermissionType {
  ABSENCE
  LATE
}

model Shift {
  id String @id @default(uuid())

  code      String  @unique
  name      String
  startTime String?
  endTime   String?
  color     String?

  isWorking Boolean @default(true)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffSchedules StaffSchedule[]

  @@map("shifts")
}

model StaffSchedule {
  id String @id @default(uuid())

  employeeId String
  branchId   String
  shiftId    String?

  workDate DateTime

  status ScheduleStatus @default(WORKING)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  attendance         Attendance?
  correctionRequests AttendanceCorrectionRequest[]

  @@unique([employeeId, branchId, workDate])
  @@index([branchId, workDate])
  @@map("staff_schedules")
}

model PermissionRequest {
  id String @id @default(uuid())

  employeeId String
  branchId   String

  type   PermissionType   @default(ABSENCE)
  date   DateTime
  reason String
  notes  String?

  estimatedArrival String?

  status PermissionStatus @default(PENDING)

  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  reviewer User?    @relation("PermissionReviewer", fields: [reviewedBy], references: [id])

  @@index([employeeId])
  @@index([branchId, date])
  @@index([status])
  @@map("permission_requests")
}

model SickLeave {
  id String @id @default(uuid())

  employeeId String
  branchId   String

  startDate DateTime
  endDate   DateTime
  totalDays Int

  hasLetter        Boolean   @default(false)
  letterDate       DateTime?
  doctorName       String?
  diagnosis        String?
  clinicName       String?
  letterPhotoUrl   String?
  letterPhotoPublicId String?

  status SickLeaveStatus @default(PENDING)

  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  reviewer User?    @relation("SickLeaveReviewer", fields: [reviewedBy], references: [id])

  @@index([employeeId])
  @@index([branchId, startDate])
  @@index([status])
  @@map("sick_leaves")
}

// =====================================================
// EMPLOYEE SALARY SETTINGS (with history)
// =====================================================

model EmployeeSalarySettings {
  id String @id @default(uuid())

  employeeId String

  baseSalary                   Decimal @db.Decimal(18, 2)
  mealAllowancePerDay          Decimal @default(0) @db.Decimal(18, 2)
  tunjangan                    Decimal @default(0) @db.Decimal(18, 2)
  transportAllowance           Decimal @default(0) @db.Decimal(18, 2)
  overtimeRatePerHour          Decimal @default(0) @db.Decimal(18, 2)
  holidayRatePerDay            Decimal @default(0) @db.Decimal(18, 2)
  lateDeductionPerMinute       Decimal @default(0) @db.Decimal(18, 2)
  absentDeductionPerDay        Decimal @default(0) @db.Decimal(18, 2)
  earlyLeaveDeductionPerMinute Decimal @default(0) @db.Decimal(18, 2)
  bpjsJhtPercent               Decimal @default(2)   @db.Decimal(5, 2)
  bpjsJhtEmployerPercent       Decimal @default(3.7) @db.Decimal(5, 2)
  bpjsJpPercent                Decimal @default(1)   @db.Decimal(5, 2)
  bpjsJpEmployerPercent        Decimal @default(2)   @db.Decimal(5, 2)
  lateDeductionBracket1        Decimal @default(25000) @db.Decimal(18, 2)
  lateDeductionBracket2        Decimal @default(50000) @db.Decimal(18, 2)
  lateDeductionBracket3        Decimal @default(75000) @db.Decimal(18, 2)
  bpjsKesehatanEmployeePercent Decimal @default(1)     @db.Decimal(5, 2)
  bpjsKesehatanEmployerPercent Decimal @default(4)     @db.Decimal(5, 2)

  effectiveDate DateTime
  endDate       DateTime?

  isActive Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("employee_salary_settings")
}

// =====================================================
// LOANS (Kasbon)
// =====================================================

enum LoanStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

model Loan {
  id String @id @default(uuid())

  employeeId String
  branchId   String

  loanNo String @unique

  totalAmount      Decimal @db.Decimal(18, 2)
  remainingAmount  Decimal @db.Decimal(18, 2)
  monthlyDeduction Decimal @db.Decimal(18, 2)

  startDate DateTime
  endDate   DateTime?

  status LoanStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee        @relation(fields: [employeeId], references: [id])
  branch     Branch          @relation(fields: [branchId], references: [id])
  repayments LoanRepayment[]

  @@index([employeeId])
  @@index([branchId])
  @@index([status])
  @@map("loans")
}

model LoanRepayment {
  id String @id @default(uuid())

  loanId    String
  payrollId String?

  amount Decimal @db.Decimal(18, 2)

  paidAt DateTime

  notes String?

  createdAt DateTime @default(now())

  loan    Loan     @relation(fields: [loanId], references: [id])
  payroll Payroll? @relation(fields: [payrollId], references: [id])

  @@index([loanId])
  @@index([payrollId])
  @@map("loan_repayments")
}

// =====================================================
// PAYROLL
// =====================================================

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum PayrollItemType {
  INCOME
  DEDUCTION
}

model Payroll {
  id String @id @default(uuid())

  employeeId String
  branchId   String

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  status PayrollStatus @default(DRAFT)

  grossIncome     Decimal @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal @default(0) @db.Decimal(18, 2)
  netSalary       Decimal @default(0) @db.Decimal(18, 2)

  approvedBy String?
  approvedAt DateTime?

  paidAt DateTime?
  paidBy String?

  submittedBy String?
  submittedAt DateTime?

  createdBy String?

  lastRecalculatedBy String?
  lastRecalculatedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  items      PayrollItem[]
  repayments LoanRepayment[]

  @@unique([employeeId, periodStart])
  @@index([employeeId])
  @@index([branchId])
  @@index([status])
  @@map("payrolls")
}

model PayrollItem {
  id String @id @default(uuid())

  payrollId String

  type     PayrollItemType
  category String
  label    String

  amount   Decimal  @db.Decimal(18, 2)
  quantity Decimal? @db.Decimal(10, 2)
  rate     Decimal? @db.Decimal(18, 2)

  isAuto Boolean @default(true)

  notes String?

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@map("payroll_items")
}

// =====================================================
// HOLIDAYS (Libur Nasional)
// =====================================================

model Holiday {
  id   String @id @default(uuid())

  date DateTime @db.Date
  name String
  year Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([year])
  @@map("holidays")
}

// =====================================================
// CLIENT CONSULTATION NOTES
// =====================================================

model ClientConsultationNote {
  id                 String  @id @default(uuid())
  invoiceId          String  @unique
  customerId         String
  branchId           String
  filledByEmployeeId String?

  // A. Profil Klien
  profession        String?
  professionOther   String?
  ageRange          String?
  dailyStyling      String[]
  dailyStylingOther String?

  // B. Motivasi & Perjalanan
  discoveryChannel       String?
  discoveryChannelDetail String?
  reasonForService       String[]
  reasonForServiceOther  String?
  hesitation             String[]
  hesitationOther        String?
  previousExpType        String?
  previousSalonName      String?
  reasonSwitchToNia      String?

  // C. Catatan Sesi
  issuesDuringUse String?
  changesAfterUse String?
  interestingNote String
  additionalNotes String?

  // D. Foto Before/After
  beforePhotoUrl      String?
  beforePhotoPublicId String?
  afterPhotoUrl       String?
  afterPhotoPublicId  String?

  filledAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice          Invoice   @relation(fields: [invoiceId], references: [id])
  customer         Customer  @relation(fields: [customerId], references: [id])
  branch           Branch    @relation(fields: [branchId], references: [id])
  filledByEmployee Employee? @relation("ConsultationFilledBy", fields: [filledByEmployeeId], references: [id])

  @@index([customerId])
  @@index([branchId])
  @@index([filledByEmployeeId])
  @@map("client_consultation_notes")
}

// =====================================================
// PURCHASE MODULE
// =====================================================

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

// =====================================================
// GL ACCOUNTS (synced from Accurate)
// =====================================================

model GlAccount {
  id String @id @default(uuid())

  accurateGlAccountId Int? @unique

  number    String?
  name      String
  category  String?
  usage     String?
  isActive  Boolean   @default(true)
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryMovements InventoryMovement[]

  @@index([number])
  @@index([name])
  @@index([category])
  @@index([usage])
  @@map("gl_accounts")
}

// =====================================================
// SUPPLIERS (synced from Accurate /vendor/list.do)
// =====================================================

model Supplier {
  id String @id @default(uuid())

  accurateVendorId Int? @unique

  name         String
  code         String?
  email        String?
  phone        String?
  address      String?
  paymentTerms String?

  isActive   Boolean   @default(true)
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseInvoices PurchaseInvoice[]

  @@index([name])
  @@map("suppliers")
}

// =====================================================
// PURCHASE INVOICES (Faktur Pembelian)
// =====================================================

model PurchaseInvoice {
  id String @id @default(uuid())

  supplierId  String
  warehouseId String?

  invoiceNo         String  @unique
  supplierInvoiceNo String?

  invoiceDate  DateTime
  dueDate      DateTime?
  deliveryDate DateTime?

  subtotal      Decimal @db.Decimal(18, 2)
  totalDiscount Decimal @default(0) @db.Decimal(18, 2)
  totalTax      Decimal @default(0) @db.Decimal(18, 2)
  grandTotal    Decimal @db.Decimal(18, 2)

  taxable      Boolean @default(false)
  inclusiveTax Boolean @default(false)

  taxInvoiceDate     DateTime?
  taxTransactionType String?
  taxInvoiceNo       String?

  paymentTerms String?
  notes        String?

  status PurchaseInvoiceStatus @default(DRAFT)

  createdByEmployeeId String?

  accuratePurchaseInvoiceId     Int?      @unique
  accuratePurchaseInvoiceNumber String?
  lastSyncAt                    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier          Supplier   @relation(fields: [supplierId], references: [id])
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])
  createdByEmployee Employee?  @relation("PurchaseInvoiceCreatedBy", fields: [createdByEmployeeId], references: [id])

  items PurchaseInvoiceItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([invoiceDate])
  @@index([createdByEmployeeId])
  @@map("purchase_invoices")
}

// =====================================================
// PURCHASE INVOICE ITEMS
// =====================================================

model PurchaseInvoiceItem {
  id String @id @default(uuid())

  purchaseInvoiceId String
  itemId            String
  unitId            String

  accurateDetailId Int?

  qty      Decimal @db.Decimal(18, 6)
  price    Decimal @db.Decimal(18, 2)
  discount Decimal @default(0) @db.Decimal(18, 2)
  subtotal Decimal @db.Decimal(18, 2)

  notes String?

  createdAt DateTime @default(now())

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id])
  unit            Unit            @relation(fields: [unitId], references: [id])

  inventoryMovements InventoryMovement[] @relation("PurchaseMovement")

  @@index([purchaseInvoiceId])
  @@index([itemId])
  @@index([unitId])
  @@map("purchase_invoice_items")
}


// =====================================================
// COMPLAINTS
// =====================================================

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintCategory {
  HASIL_LAYANAN
  SIKAP_KARYAWAN
  WAKTU_TUNGGU
  HARGA
  FASILITAS
  PRODUK
  LAINNYA
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
}

model Complaint {
  id          String @id @default(uuid())
  complaintNo String @unique

  branchId      String
  appointmentId String
  invoiceId     String?

  // Karyawan yang dikomplain (opsional, bisa dari appointment staff)
  employeeId String?

  category    ComplaintCategory
  severity    ComplaintSeverity @default(MEDIUM)
  description String

  status    ComplaintStatus @default(OPEN)
  handledBy String?         // userId manager yang handle

  // Follow up & komunikasi
  followUpDate DateTime? // Tanggal Follow up
  chatNotes    String?   // Log chat / komunikasi dengan klien

  // Resolusi
  resolutionNotes String?
  followUpAction  String?
  resolvedAt      DateTime?

  // Perbaikan / Redo
  repairDate      DateTime? // Tanggal Perbaikan
  repairNotes     String?   // Keterangan hasil perbaikan
  repairStaff     String?   // Nama hairstylist/colorist yg perbaiki
  repairAssistant String?   // Nama asisten perbaikan

  // Pemotongan komisi (diisi manual saat resolve)
  correctedStrands          Int?
  totalStrands              Int?
  commissionId              String?
  commissionDeductionAmount Decimal? @db.Decimal(18, 2)

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch      Branch      @relation(fields: [branchId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])
  employee    Employee?   @relation("ComplaintEmployee", fields: [employeeId], references: [id])

  @@index([branchId])
  @@index([appointmentId])
  @@index([invoiceId])
  @@index([employeeId])
  @@index([status])
  @@map("complaints")
}
