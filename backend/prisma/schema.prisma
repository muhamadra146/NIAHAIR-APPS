enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CommissionBase {
  BEFORE_DISCOUNT
  AFTER_DISCOUNT
  BEFORE_DISCOUNT_BEFORE_TAX
  AFTER_DISCOUNT_BEFORE_TAX
  BEFORE_DISCOUNT_AFTER_TAX
  AFTER_DISCOUNT_AFTER_TAX
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ColoristCondition {
  ANY     // rule selalu berlaku
  PRESENT // hanya berlaku jika ada colorist di assignment treatment ini
  ABSENT  // hanya berlaku jika tidak ada colorist di assignment treatment ini
}

