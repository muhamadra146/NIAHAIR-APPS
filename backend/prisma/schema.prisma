generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// MASTER DATA - BATCH 1
// =====================================================

enum Gender {
  MALE
  FEMALE
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// =====================================================
// BRANCHES
// =====================================================

model Branch {
  id String @id @default(uuid())

  code String @unique
  name String

  address  String?
  city     String?
  province String?
  phone    String?

  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  radiusMeters Int      @default(100)

  isActive Boolean @default(true)

  accurateBranchId Int?      @unique
  lastSyncAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeEmployees           Employee[]              @relation("EmployeeHomeBranch")
  employeeBranchHistories EmployeeBranchHistory[]
  employeeBranches        EmployeeBranch[]

  itemPrices            ItemPrice[]
  warehouses            Warehouse[]
  invoices              Invoice[]
  appointments          Appointment[]
  deposits              Deposit[]
  payments              Payment[]
  treatmentSessions     TreatmentSession[]
  staffSchedules        StaffSchedule[]
  attendances           Attendance[]
  loans                 Loan[]
  payrolls              Payroll[]
  consultationNotes     ClientConsultationNote[]
  correctionRequests    AttendanceCorrectionRequest[]
  permissionRequests    PermissionRequest[]
  sickLeaves            SickLeave[]
  complaints            Complaint[]

  @@map("branches")
}

// =====================================================
// USER ROLES
// =====================================================

model UserRole {
  id String @id @default(uuid())

  code String @unique
  name String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("user_roles")
}

// =====================================================
// USERS
// =====================================================

model User {
  id String @id @default(uuid())

  userRoleId String
  employeeId String @unique

  email    String  @unique
  username String? @unique

  passwordHash String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role     UserRole @relation(fields: [userRoleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  reviewedCorrections AttendanceCorrectionRequest[] @relation("CorrectionReviewer")
  reviewedPermissions PermissionRequest[]           @relation("PermissionReviewer")
  reviewedSickLeaves  SickLeave[]                   @relation("SickLeaveReviewer")

  @@index([userRoleId])
  @@index([employeeId])
  @@map("users")
}

// =====================================================
// EMPLOYEE ROLES
// =====================================================

model EmployeeRole {
  id String @id @default(uuid())

  code String @unique
  name String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("employee_roles")
}

// =====================================================
// EMPLOYEES
// =====================================================

model Employee {
  id String @id @default(uuid())

  roleId       String
  homeBranchId String?

  employeeCode String @unique

  name String

  phone String?
  email String? @unique

  hireDate DateTime?

  birthDate DateTime?

  address String?

  emergencyContact String?

  nikKtp               String?
  ktpFileUrl           String?
  ktpFilePublicId      String?

  resignDate           DateTime?

  contractFileUrl      String?
  contractFilePublicId String?

  commissionEnabled Boolean @default(true)

  isActive Boolean @default(true)

  payDay Int? // tanggal gajian: 1, 7, 14, dst.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role       EmployeeRole @relation(fields: [roleId], references: [id])
  homeBranch Branch?      @relation("EmployeeHomeBranch", fields: [homeBranchId], references: [id])

  branchHistories  EmployeeBranchHistory[]
  employeeBranches EmployeeBranch[]
  user             User?

  createdAppointments Appointment[]            @relation("AppointmentCreatedBy")
  createdDeposits     Deposit[]                @relation("DepositCreatedBy")
  createdInvoices     Invoice[]                @relation("InvoiceCreatedBy")
  createdPayments     Payment[]                @relation("PaymentCreatedBy")
  filledConsultations ClientConsultationNote[] @relation("ConsultationFilledBy")

  appointmentStaffs     AppointmentStaff[]
  treatmentAssignments  TreatmentAssignment[]
  commissionRules       CommissionRule[]
  commissions              Commission[]
  attendances              Attendance[]
  schedules                EmployeeSchedule[]
  leaves                   Leave[]
  overtimeChargeEmployees  OvertimeChargeEmployee[]
  staffSchedules        StaffSchedule[]
  salarySettings        EmployeeSalarySettings[]
  loans                 Loan[]
  payrolls              Payroll[]
  leaveQuotas           LeaveQuota[]
  correctionRequests    AttendanceCorrectionRequest[]
  permissionRequests    PermissionRequest[]
  sickLeaves            SickLeave[]

  inventoryMovements    InventoryMovement[] @relation("InventoryMovementCreatedBy")
  inventoryPeriods      InventoryPeriod[]   @relation("InventoryPeriodClosedBy")
  purchaseInvoices      PurchaseInvoice[]   @relation("PurchaseInvoiceCreatedBy")

  complaintsAbout         Complaint[]              @relation("ComplaintEmployee")
  treatmentJobAssignments TreatmentJobAssignment[]

  @@index([roleId])
  @@index([homeBranchId])
  @@map("employees")
}

// =====================================================
// EMPLOYEE BRANCH HISTORIES
// =====================================================

model EmployeeBranchHistory {
  id String @id @default(uuid())

  employeeId String
  branchId   String

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@index([employeeId])
  @@index([branchId])
  @@map("employee_branch_histories")
}

// =====================================================
// EMPLOYEE BRANCHES (access permissions per branch)
// =====================================================

model EmployeeBranch {
  id String @id @default(uuid())

  employeeId String
  branchId   String

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@unique([employeeId, branchId])
  @@index([employeeId])
  @@index([branchId])
  @@map("employee_branches")
}

// =====================================================
// MEMBERSHIPS
// =====================================================

model Membership {
  id String @id @default(uuid())

  name String

  price Decimal @db.Decimal(18, 2)

  durationDays Int

  discountType  DiscountType
  discountValue Decimal      @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerMemberships CustomerMembership[]
  customers           Customer[]
  membershipHistories MembershipHistory[]
  invoices            Invoice[]

  @@map("memberships")
}

// =====================================================
// CUSTOMER SYNC ENUMS
// =====================================================

enum CustomerSyncSource {
  LOCAL
  ACCURATE
}

enum CustomerSyncStatus {
  PENDING
  SYNCED
  FAILED
}

// =====================================================
// CUSTOMERS
// =====================================================

model Customer {
  id String @id @default(uuid())

  accurateCustomerId Int? @unique

  customerNo String? @unique

  name String

  mobilePhone String? @unique

  email String?

  address String?

  city     String?
  province String?

  birthDate DateTime?

  gender Gender?

  membershipId String?

  notes String?

  lastVisitAt DateTime?

  isActive Boolean @default(true)

  syncSource        CustomerSyncSource @default(LOCAL)
  syncStatus        CustomerSyncStatus @default(PENDING)
  syncError         String?
  lastSyncAttemptAt DateTime?

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membership Membership? @relation(fields: [membershipId], references: [id])

  customerMemberships CustomerMembership[]
  membershipHistories MembershipHistory[]

  appointments      Appointment[]
  invoices          Invoice[]
  deposits          Deposit[]
  treatmentSessions TreatmentSession[]
  customerNotes     CustomerNote[]
  consultationNotes ClientConsultationNote[]

  @@index([membershipId])
  @@index([name])
  @@map("customers")
}

// =====================================================
// CUSTOMER MEMBERSHIPS
// =====================================================

model CustomerMembership {
  id String @id @default(uuid())

  customerId   String
  membershipId String

  startDate DateTime
  endDate   DateTime

  status MembershipStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([customerId])
  @@index([membershipId])
  @@index([customerId, status, endDate])
  @@map("customer_memberships")
}

// =====================================================
// MEMBERSHIP HISTORIES
// =====================================================

model MembershipHistory {
  id String @id @default(uuid())

  customerId   String
  membershipId String

  startDate DateTime
  endDate   DateTime

  createdBy String?

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([customerId])
  @@index([membershipId])
  @@map("membership_histories")
}

// =====================================================
// ITEM MASTER
// =====================================================

enum ItemType {
  INVENTORY
  SERVICE
}

// =====================================================
// ITEM CATEGORIES
// =====================================================

model ItemCategory {
  id String @id @default(uuid())

  accurateCategoryId Int? @unique

  name String

  parentId String?
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([name])
  @@index([parentId])
  @@map("item_categories")
}

// =====================================================
// UNITS
// =====================================================

model Unit {
  id String @id @default(uuid())

  accurateUnitId Int? @unique

  name String

  isActive Boolean @default(true)

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemUnits ItemUnit[]

  itemPrices ItemPrice[]

  defaultItems  Item[] @relation("ItemDefaultUnit")
  purchaseItems Item[] @relation("ItemPurchaseUnit")

  serviceMaterials     ServiceMaterial[]
  materialUsageItems   MaterialUsageItem[]
  invoiceItems         InvoiceItem[]
  treatmentItems       TreatmentItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@index([name])
  @@map("units")
}

// =====================================================
// ITEMS
// =====================================================

model Item {
  id String @id @default(uuid())

  categoryId           String?
  defaultUnitId        String?
  purchaseUnitId       String?
  commissionCategoryId String?

  accurateItemId Int? @unique

  itemCode String @unique

  name String

  itemType ItemType

  isActive Boolean @default(true)

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ItemCategory? @relation(fields: [categoryId], references: [id])

  defaultUnit  Unit? @relation("ItemDefaultUnit",  fields: [defaultUnitId],  references: [id])
  purchaseUnit Unit? @relation("ItemPurchaseUnit", fields: [purchaseUnitId], references: [id])

  commissionCategory CommissionCategory? @relation(fields: [commissionCategoryId], references: [id])

  itemUnits ItemUnit[]

  itemPrices ItemPrice[]

  inventories          Inventory[]
  stockTransferItems   StockTransferItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  appointmentServices AppointmentService[]
  invoiceItems        InvoiceItem[]
  commissions         Commission[]
  treatmentItems      TreatmentItem[]
  materialUsageItems  MaterialUsageItem[]
  serviceMaterials    ServiceMaterial[]    @relation("ServiceMaterials")
  usedAsMaterial      ServiceMaterial[]    @relation("MaterialItems")
  serviceJobSlots     ServiceJobSlot[]
  serviceJobRoles     ServiceJobRole[]

  @@index([itemType])
  @@index([categoryId])
  @@index([defaultUnitId])
  @@index([purchaseUnitId])
  @@index([commissionCategoryId])
  @@index([name])
  @@map("items")
}

// =====================================================
// SERVICE JOB SLOTS
// =====================================================

model ServiceJobSlot {
  id String @id @default(uuid())

  itemId String

  slotKey String // e.g. "remove", "cuci", "service_lem", "bantu_masang"

  label String // e.g. "Remove Rambut"

  commissionRate Decimal @db.Decimal(8, 4) // % dari subtotal, e.g. 0.2500 = 0.25%

  commissionMode CommissionMode @default(FIXED_RATE)
  // FIXED_RATE: satu orang, komisi langsung = subtotal × rate
  // WORK_QTY  : banyak orang, dibagi proporsional berdasarkan workQty (helaian)

  // Role-based system (baru) — null = slot lama (backward compat, engine lama dipakai)
  roleId    String?  // FK → ServiceJobRole
  isMainJob Boolean  @default(false)   // true = job utama, dapat sisa pool setelah FLAT dibayar
  slotType  SlotType @default(PERCENTAGE)
  // PERCENTAGE: dapat bagian dari role pool (job utama, pakai workQty kalau banyak staff)
  // FLAT      : dapat flat amount manual per treatment, dipotong dari pool terlebih dahulu

  isRequired Boolean @default(false)

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item           Item             @relation(fields: [itemId], references: [id])
  serviceJobRole ServiceJobRole?  @relation(fields: [roleId], references: [id])

  treatmentJobAssignments TreatmentJobAssignment[]

  commissions Commission[] @relation("CommissionJobSlot")

  @@unique([itemId, slotKey])
  @@index([itemId])
  @@index([roleId])
  @@map("service_job_slots")
}

enum CommissionMode {
  FIXED_RATE
  WORK_QTY
}

enum SlotType {
  PERCENTAGE // slot dapat bagian dari role pool (default, job utama)
  FLAT       // slot dapat flat amount manual, dipotong dari pool terlebih dahulu
}

// =====================================================
// SERVICE JOB ROLES
// =====================================================

model ServiceJobRole {
  id             String  @id @default(uuid())
  itemId         String
  roleName       String  // e.g. "Pemasang", "Asisten"
  commissionRate Decimal @db.Decimal(8, 4) // % dari subtotal item, e.g. 5.0000 = 5%
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item  Item             @relation(fields: [itemId], references: [id])
  slots ServiceJobSlot[]

  @@unique([itemId, roleName])
  @@index([itemId])
  @@map("service_job_roles")
}

// =====================================================
// ITEM UNITS
// =====================================================

model ItemUnit {
  id String @id @default(uuid())

  itemId String
  unitId String

  conversionFactor Decimal @db.Decimal(18, 6)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id])

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([itemId, unitId])
  @@index([itemId])
  @@index([unitId])
  @@map("item_units")
}

// =====================================================
// ITEM PRICES
// =====================================================

model ItemPrice {
  id String @id @default(uuid())

  itemId String
  unitId String

  branchId String?

  sellingPrice Decimal  @db.Decimal(18, 2)
  costPrice    Decimal? @db.Decimal(18, 2)

  effectiveDate DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id])

  unit Unit @relation(fields: [unitId], references: [id])

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([itemId])
  @@index([unitId])
  @@index([branchId])
  @@map("item_prices")
}

// =====================================================
// INVENTORY
// =====================================================

enum InventoryReferenceType {
  INVOICE
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  TRANSFER
  TREATMENT
  PRODUCTION
  STOCK_OPNAME
  OPENING_BALANCE
  MANUAL
  SYNC
}

enum InventoryCreatedSource {
  USER
  SYSTEM
  SYNC
  WORKER
}

enum InventorySourceModule {
  SALE
  SERVICE
  PURCHASE
  PRODUCTION
  TRANSFER
  ADJUSTMENT
  OPNAME
  SYNC
  OPENING_BALANCE
}

enum InventoryMovementType {
  PURCHASE
  SALE
  SERVICE_USAGE
  PRODUCTION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING_BALANCE
  RETURN
  SYNC
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum InventoryPeriodStatus {
  OPEN
  CLOSED
}

// =====================================================
// WAREHOUSES
// =====================================================

model Warehouse {
  id String @id @default(uuid())

  branchId String?

  accurateWarehouseId Int? @unique

  name String

  isActive Boolean @default(true)

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])

  inventories Inventory[]

  transferOuts StockTransfer[] @relation("TransferSource")

  transferIns StockTransfer[] @relation("TransferDestination")

  purchaseInvoices PurchaseInvoice[]

  @@index([branchId])
  @@map("warehouses")
}

// =====================================================
// INVENTORIES
// =====================================================

model Inventory {
  id String @id @default(uuid())

  warehouseId String

  itemId String

  qtyOnHand    Decimal @db.Decimal(18, 6)

  qtyReserved  Decimal @db.Decimal(18, 6)

  qtyAvailable Decimal @db.Decimal(18, 6)

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  item Item @relation(fields: [itemId], references: [id])

  movements InventoryMovement[]

  @@unique([warehouseId, itemId])
  @@index([warehouseId])
  @@index([itemId])
  @@map("inventories")
}

// =====================================================
// STOCK MOVEMENTS
// =====================================================

model InventoryMovement {
  id String @id @default(uuid())

  inventoryId String

  movementType InventoryMovementType

  qtyBefore Decimal @db.Decimal(18, 6)

  qtyChange Decimal @db.Decimal(18, 6)

  qtyAfter Decimal @db.Decimal(18, 6)

  referenceType InventoryReferenceType?

  referenceId String?

  referenceNo String?

  notes String?

  reason String?

  sourceModule InventorySourceModule?

  unitCost Decimal? @db.Decimal(18, 6)

  createdSource InventoryCreatedSource?

  warehouseId String?

  createdBy String?

  createdByEmployeeId String?

  isLocked Boolean @default(false)

  accurateAdjustmentId Int?
  glAccountId          String?
  purchaseInvoiceItemId String?

  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  createdByEmployee Employee? @relation("InventoryMovementCreatedBy", fields: [createdByEmployeeId], references: [id])

  glAccount GlAccount? @relation(fields: [glAccountId], references: [id])

  purchaseInvoiceItem PurchaseInvoiceItem? @relation("PurchaseMovement", fields: [purchaseInvoiceItemId], references: [id])

  materialUsageItems MaterialUsageItem[]

  @@index([inventoryId])
  @@index([referenceType, referenceId])
  @@index([movementType])
  @@index([sourceModule])
  @@index([referenceNo])
  @@index([warehouseId])
  @@index([createdSource])
  @@index([createdAt])
  @@index([createdByEmployeeId])
  @@index([isLocked])
  @@index([glAccountId])
  @@index([purchaseInvoiceItemId])
  @@map("inventory_movements")
}

// =====================================================
// INVENTORY PERIODS
// =====================================================

model InventoryPeriod {
  id   String @id @default(uuid())

  year  Int
  month Int

  status InventoryPeriodStatus @default(OPEN)

  closedAt DateTime?

  closedByEmployeeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  closedByEmployee Employee? @relation("InventoryPeriodClosedBy", fields: [closedByEmployeeId], references: [id])

  @@unique([year, month])
  @@index([status])
  @@map("inventory_periods")
}

// =====================================================
// STOCK TRANSFERS
// =====================================================

model StockTransfer {
  id String @id @default(uuid())

  sourceWarehouseId String

  destinationWarehouseId String

  transferNo String @unique

  status StockTransferStatus

  notes String?

  transferDate DateTime

  createdBy String?

  accurateTransferId     Int?      @unique
  accurateTransferNumber String?
  lastSyncAt             DateTime?

  accurateReceiveId     Int?      @unique
  accurateReceiveNumber String?
  lastReceiveSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceWarehouse Warehouse @relation("TransferSource", fields: [sourceWarehouseId], references: [id])

  destinationWarehouse Warehouse @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])

  items StockTransferItem[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@map("stock_transfers")
}

// =====================================================
// STOCK TRANSFER ITEMS
// =====================================================

model StockTransferItem {
  id String @id @default(uuid())

  transferId String

  itemId String

  qty         Decimal  @db.Decimal(18, 6)
  receivedQty Decimal? @db.Decimal(18, 6)

  accurateDetailId Int?

  createdAt DateTime @default(now())

  transfer StockTransfer @relation(fields: [transferId], references: [id])

  item Item @relation(fields: [itemId], references: [id])

  @@index([transferId])
  @@index([itemId])
  @@map("stock_transfer_items")
}

// =====================================================
// SERVICE BOM
// =====================================================

model ServiceMaterial {
  id String @id @default(uuid())

  serviceItemId  String
  materialItemId String

  unitId String

  qty Decimal @db.Decimal(18, 6)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceItem Item @relation("ServiceMaterials", fields: [serviceItemId], references: [id])

  materialItem Item @relation("MaterialItems", fields: [materialItemId], references: [id])

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([serviceItemId, materialItemId])
  @@index([serviceItemId])
  @@index([materialItemId])
  @@map("service_materials")
}

// =====================================================
// MATERIAL USAGES
// =====================================================

model MaterialUsage {
  id String @id @default(uuid())

  treatmentItemId String

  processedAt DateTime

  createdAt DateTime @default(now())

  treatmentItem TreatmentItem @relation(fields: [treatmentItemId], references: [id])

  usageItems MaterialUsageItem[]

  @@index([treatmentItemId])
  @@map("material_usages")
}

// =====================================================
// MATERIAL USAGE ITEMS
// =====================================================

model MaterialUsageItem {
  id String @id @default(uuid())

  materialUsageId String

  materialItemId String

  unitId String

  inventoryMovementId String?

  qty Decimal @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  materialUsage     MaterialUsage      @relation(fields: [materialUsageId], references: [id])

  materialItem Item @relation(fields: [materialItemId], references: [id])

  unit Unit @relation(fields: [unitId], references: [id])

  inventoryMovement InventoryMovement? @relation(fields: [inventoryMovementId], references: [id])

  @@index([materialUsageId])
  @@index([materialItemId])
  @@index([inventoryMovementId])
  @@map("material_usage_items")
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECK_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  SALON
  HOME_SERVICE
}

enum AppointmentPhotoType {
  REFERENCE
  HAIR_CURRENT
}

enum DepositStatus {
  PENDING
  UNPAID
  PARTIAL
  PAID
  PARTIAL_USED
  USED
  REFUNDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

model Appointment {
  id String @id @default(uuid())

  customerId String
  branchId   String

  bookingNo String @unique

  bookingDate DateTime

  visitDate DateTime

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus

  type               AppointmentType @default(SALON)
  homeServiceAddress String?

  notes String?

  estimatedTotal Decimal? @db.Decimal(18, 2)

  createdByEmployeeId String?

  cancelReason      String?
  cancelledAt       DateTime?
  cancelledByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer          Customer  @relation(fields: [customerId], references: [id])
  branch            Branch    @relation(fields: [branchId], references: [id])
  createdByEmployee Employee? @relation("AppointmentCreatedBy", fields: [createdByEmployeeId], references: [id])

  services AppointmentService[]

  staffs AppointmentStaff[]

  deposits Deposit[]

  invoices Invoice[]

  statusHistories AppointmentStatusHistory[]

  rescheduleHistories AppointmentRescheduleHistory[]

  treatmentSessions TreatmentSession[]

  photos AppointmentPhoto[]

  complaints Complaint[]

  @@index([customerId])
  @@index([branchId])
  @@index([visitDate])
  @@index([createdByEmployeeId])
  @@map("appointments")
}

model AppointmentRescheduleHistory {
  id            String @id @default(uuid())
