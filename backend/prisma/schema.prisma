model CommissionCategory {
  id String @id @default(uuid())

  code String @unique
  name String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           Item[]
  commissionRules CommissionRule[]
  jobs            CommissionJob[]

  @@map("commission_categories")
}

// Job per kategori — daftar pekerjaan yang bisa dikerjakan dalam satu kategori layanan.
// Contoh: kategori "Pasang Baru" → jobs: Pasang, Remove, Cuci, Styling, Bantu Pasang
model CommissionJob {
  id                   String   @id @default(uuid())
  commissionCategoryId String
  name                 String   // "Pasang Baru", "Remove", "Cuci"
  jobKey               String   // "pasang_baru", "remove", "cuci" (URL-safe identifier)
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)

  // Chain deduction: jika diisi, job ini memotong base/komisi dari job yang ditunjuk.
  // PERCENTAGE helper → potong BASE primary; FLAT helper → potong KOMISI primary.
  deductsFromJobId String?   @map("deducts_from_job_id")
  // Harga default per unit untuk PERCENTAGE helper (bisa di-override di kalkulator).
  pricePerUnit     Decimal?  @db.Decimal(15, 2) @map("price_per_unit")
  // Satuan unit helper — bebas diisi: "helai", "sesi", "cm", dll.
  unit             String    @default("helai") @map("unit")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissionCategory CommissionCategory       @relation(fields: [commissionCategoryId], references: [id])
  commissionRules    CommissionRule[]
  jobAssignments     TreatmentJobAssignment[]

  // Self-referential: job ini memotong dari job lain dalam kategori yang sama
  deductsFrom CommissionJob?  @relation("JobDeduction", fields: [deductsFromJobId], references: [id])
  deductedBy  CommissionJob[] @relation("JobDeduction")

  @@unique([commissionCategoryId, jobKey])
  @@index([commissionCategoryId])
  @@map("commission_jobs")
}

model CommissionRule {
  id String @id @default(uuid())

  employeeId           String
  commissionCategoryId String
  slotKey              String?        // lama — backward compat
  commissionJobId      String?        // baru — referensi ke CommissionJob

  commissionType CommissionType

  commissionValue Decimal @db.Decimal(18, 2)

  commissionBase CommissionBase @default(AFTER_DISCOUNT)

  // Untuk aturan pengganti colorist (mis. Surya/Ulvi):
  // PRESENT = hanya berlaku jika ada colorist di assignment, ABSENT = jika tidak ada
  coloristCondition ColoristCondition @default(ANY)

  effectiveDate DateTime
  endDate       DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee           Employee           @relation(fields: [employeeId], references: [id])
  commissionCategory CommissionCategory @relation(fields: [commissionCategoryId], references: [id])
  commissionJob      CommissionJob?     @relation(fields: [commissionJobId], references: [id])

  commissions Commission[]

  // coloristCondition masuk unique agar Surya/Ulvi bisa punya rule PRESENT dan ABSENT pada tanggal yang sama
  // commissionJobId masuk unique agar satu karyawan bisa punya rule berbeda per job dalam kategori yang sama
  @@unique([employeeId, commissionCategoryId, slotKey, commissionJobId, coloristCondition, effectiveDate])
  @@index([employeeId])
  @@index([commissionCategoryId])
  @@index([commissionJobId])
  @@map("commission_rules")
}

model Commission {
  id String @id @default(uuid())

  invoiceId String

  invoiceItemId String?

  treatmentAssignmentId String?

  // Untuk komisi berbasis job slot (sistem baru)
  treatmentJobAssignmentId String?

  serviceJobSlotId String?

  employeeId String

  serviceItemId String

  commissionRuleId String?

  workQty Decimal? @db.Decimal(18, 2)

  workRatio Decimal? @db.Decimal(18, 6)

  commissionType CommissionType

  commissionValue Decimal @db.Decimal(18, 2)

  commissionBase CommissionBase

  baseAmount Decimal @db.Decimal(18, 2)

  commissionAmount Decimal @db.Decimal(18, 2)

  status CommissionStatus

  approvedBy String?

  approvedAt DateTime?

  paidBy String?

  paidAt DateTime?

  notes String?

  // Komisi hangus jika TreatmentSession.completedAt tidak hari yang sama dengan invoice.invoiceDate (WIB)
  isForfeit     Boolean   @default(false)
  forfeitReason String?

  // Override manual oleh CS/Manager ketika ada komplain
  isManualOverride Boolean   @default(false)
  overrideBy       String?
  overrideAt       DateTime?
  overrideNotes    String?

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id])

  treatmentAssignment    TreatmentAssignment?    @relation(fields: [treatmentAssignmentId],    references: [id])
  treatmentJobAssignment TreatmentJobAssignment? @relation(fields: [treatmentJobAssignmentId], references: [id])
  serviceJobSlot         ServiceJobSlot?         @relation("CommissionJobSlot", fields: [serviceJobSlotId], references: [id])

  employee Employee @relation(fields: [employeeId], references: [id])

  serviceItem Item @relation(fields: [serviceItemId], references: [id])

  commissionRule CommissionRule? @relation(fields: [commissionRuleId], references: [id])

  @@unique([treatmentAssignmentId])
  @@unique([treatmentJobAssignmentId])
  @@index([invoiceId])
  @@index([employeeId])
  @@index([status])
  @@index([commissionRuleId])
  @@index([serviceJobSlotId])
  @@map("commissions")
}

